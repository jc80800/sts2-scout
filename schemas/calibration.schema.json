{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calibration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "aspectRatio": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10
    },
    "threshold": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 1
    },
    "margin": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "screen",
              "entity",
              "price",
              "upgrade",
              "selection"
            ]
          },
          "screen": {
            "type": "string",
            "enum": [
              "CardReward",
              "Merchant"
            ]
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "pixels": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              },
              "required": [
                "label",
                "width",
                "height",
                "pixels"
              ]
            }
          }
        },
        "required": [
          "kind",
          "screen",
          "slot",
          "region",
          "templates"
        ]
      }
    },
    "rewardNameRegions": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "gameVersion",
    "aspectRatio",
    "threshold",
    "margin",
    "probes"
  ]
}
