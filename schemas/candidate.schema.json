{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "CardSynergy",
          "RelicSynergy",
          "AntiSynergy",
          "Archetype",
          "DeckNeed",
          "MerchantPriority"
        ]
      },
      "subject": {
        "type": "string",
        "minLength": 1
      },
      "other": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "tag": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "weight": {
        "type": "number",
        "minimum": -20,
        "maximum": 20
      },
      "gameVersion": {
        "type": "string",
        "minLength": 1
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri"
      },
      "evidenceType": {
        "type": "string",
        "enum": [
          "expert-opinion",
          "mechanic",
          "correlation",
          "synthetic"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "evidenceLocator": {
        "type": "string",
        "minLength": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "kind",
      "subject",
      "other",
      "tag",
      "weight",
      "gameVersion",
      "sourceUrl",
      "evidenceType",
      "confidence",
      "evidenceLocator",
      "reason"
    ]
  }
}
