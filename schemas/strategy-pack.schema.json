{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "strategy-pack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "packVersion": {
      "type": "string",
      "minLength": 1
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "Card",
              "Relic",
              "Potion",
              "Service"
            ]
          },
          "baseline": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "setupRisk": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "baselineReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "facts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "normalizedName": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "character": {
                "type": "string",
                "enum": [
                  "ironclad",
                  "silent",
                  "defect",
                  "regent",
                  "necrobinder",
                  "colorless",
                  "shared",
                  "event",
                  "curse",
                  "token",
                  "status",
                  "quest"
                ]
              },
              "rarity": {
                "type": "string"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cost": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "starCost": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target": {
                "type": "string"
              },
              "rewardPool": {
                "type": "boolean"
              },
              "multiplayerOnly": {
                "type": "boolean"
              },
              "values": {
                "type": "object"
              },
              "upgrade": {
                "type": "object"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gameVersion": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              }
            },
            "required": [
              "normalizedName",
              "aliases",
              "character",
              "rarity",
              "type",
              "cost",
              "starCost",
              "target",
              "rewardPool",
              "multiplayerOnly",
              "values",
              "upgrade",
              "keywords",
              "gameVersion",
              "sourceId"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "baseline",
          "tags"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "CardSynergy",
              "RelicSynergy",
              "AntiSynergy",
              "Archetype",
              "DeckNeed",
              "MerchantPriority"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "other": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "weight": {
            "type": "number",
            "minimum": -20,
            "maximum": 20
          },
          "gameVersion": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "retrievedAt": {
                "type": "string",
                "format": "date-time"
              },
              "publishedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gameVersion": {
                "type": "string",
                "minLength": 1
              },
              "evidenceType": {
                "type": "string",
                "enum": [
                  "expert-opinion",
                  "mechanic",
                  "correlation",
                  "synthetic"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidenceHash": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "evidenceLocator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceUrl",
              "retrievedAt",
              "publishedAt",
              "gameVersion",
              "evidenceType",
              "confidence",
              "evidenceHash",
              "license",
              "evidenceLocator"
            ]
          },
          "reviewState": {
            "type": "string",
            "enum": [
              "approved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "subject",
          "other",
          "tag",
          "weight",
          "gameVersion",
          "source",
          "reviewState",
          "reason"
        ]
      }
    },
    "catalog": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "branch": {
          "const": "main"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "url",
              "gameVersion",
              "branch",
              "sha256",
              "rights"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "gameVersion": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "rights": {
                "type": "string"
              }
            }
          }
        },
        "strategyMethod": {
          "type": "string"
        }
      },
      "required": [
        "branch",
        "generatedAt",
        "sources",
        "strategyMethod"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "packVersion",
    "gameVersion",
    "entities",
    "claims"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "catalog"
        ],
        "properties": {
          "catalog": {
            "type": "object"
          },
          "entities": {
            "minItems": 1,
            "items": {
              "required": [
                "facts",
                "baselineReason"
              ],
              "properties": {
                "facts": {
                  "type": "object"
                },
                "baselineReason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
